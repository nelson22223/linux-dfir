{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linux DFIR Timeline Event",
  "type": "object",
  "required": ["schema_version", "artifact_id", "case_id", "host_id", "session_id", "collector", "event_type", "timestamp", "collected_at", "source_path", "source_type", "source_trust", "raw_artifact_ref"],
  "properties": {
    "schema_version": { "type": "string" },
    "artifact_id": { "type": "string" },
    "case_id": { "type": "string" },
    "host_id": { "type": "string" },
    "session_id": { "type": "string" },
    "collector": { "type": "string" },
    "event_type": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "collected_at": { "type": "string", "format": "date-time" },
    "source_path": { "type": "string" },
    "source_type": { "type": "string" },
    "source_trust": { "type": "string" },
    "raw_artifact_ref": { "type": "string" },
    "summary": { "type": "string" }
  }
}
